<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClaudeProfiles.ViewModels"
        xmlns:views="using:ClaudeProfiles.Views"
        xmlns:profiles="using:ClaudeProfiles.Core.Profiles"
        x:Class="ClaudeProfiles.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Profils Claude"
        Icon="/Assets/app.ico"
        Width="740" Height="600"
        MinWidth="540" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBackgroundBrush}">

  <Grid>
    <DockPanel Margin="40,36,40,28">

      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,24">
        <StackPanel Spacing="6">
          <TextBlock Classes="title" Text="Profils Claude" />
          <TextBlock Classes="subtitle" TextWrapping="Wrap"
                     Text="Choisissez avec quel compte ouvrir Claude. Chaque profil garde sa propre connexion, ses conversations et ses réglages." />
        </StackPanel>
        <Button Grid.Column="1" Classes="accent" VerticalAlignment="Top" Margin="24,4,0,0"
                Command="{Binding StartCreationCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="+" FontSize="17" Margin="0,-2,0,0" VerticalAlignment="Center" />
            <TextBlock Text="Nouveau profil" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>

      <Border DockPanel.Dock="Top" Classes="error" Margin="0,0,0,16"
              IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="ghost icon" Content="✕" FontSize="13" Margin="8,0,0,0"
                  ToolTip.Tip="Masquer" Command="{Binding DismissErrorCommand}" />
        </Grid>
      </Border>

      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Profiles}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="10" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ProfileItemViewModel">
              <Border Classes="card">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                  <Border Classes="avatar"
                          Background="{Binding Profile.Color, Converter={x:Static views:ProfileColorToBrushConverter.Instance}}">
                    <TextBlock Text="{Binding Initial}" />
                  </Border>

                  <StackPanel Grid.Column="1" Margin="14,0,16,0" Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="profileName" Text="{Binding DisplayName}" />
                      <Border Classes="chip" IsVisible="{Binding Profile.IsDefault}">
                        <TextBlock Text="Profil d'origine" />
                      </Border>
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                      <Ellipse Classes="status" Classes.running="{Binding IsRunning}"
                               VerticalAlignment="Center" Margin="0,1,7,0" />
                      <TextBlock Grid.Column="1" Classes="caption" Text="{Binding StatusText}" />
                      <TextBlock Grid.Column="2" Classes="caption" Text="·" Margin="6,0" />
                      <TextBlock Grid.Column="3" Classes="caption" Text="{Binding DataDirectory}"
                                 TextTrimming="PrefixCharacterEllipsis"
                                 ToolTip.Tip="{Binding DataDirectory}" />
                    </Grid>
                  </StackPanel>

                  <Button Grid.Column="2" Classes="outline" MinWidth="92" VerticalAlignment="Center"
                          HorizontalContentAlignment="Center"
                          Content="{Binding LaunchLabel}" Command="{Binding LaunchCommand}" />

                  <Button Grid.Column="3" Classes="ghost icon" Content="⋯" Margin="6,0,0,0"
                          VerticalAlignment="Center" ToolTip.Tip="Plus d'actions">
                    <Button.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Header="Modifier…" Command="{Binding EditCommand}" />
                        <MenuItem Header="Ouvrir le dossier des données" Command="{Binding OpenFolderCommand}" />
                        <Separator IsVisible="{Binding CanDelete}" />
                        <MenuItem Classes="danger" Header="Supprimer…" IsVisible="{Binding CanDelete}"
                                  Command="{Binding RequestDeletionCommand}" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>

                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <Border Classes="scrim" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Classes="dialog">
        <StackPanel Spacing="18">
          <TextBlock Classes="dialogTitle" Text="{Binding Editor.Title}" />

          <StackPanel Spacing="6">
            <TextBlock Classes="fieldLabel" Text="Nom" />
            <TextBox x:Name="ProfileNameBox" Text="{Binding Editor.Name}"
                     PlaceholderText="Par exemple : Travail, Client Dupont…" />
            <TextBlock Classes="fieldError" Text="{Binding Editor.NameError}"
                       IsVisible="{Binding Editor.NameError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Classes="fieldLabel" Text="Couleur" />
            <ListBox Classes="swatches"
                     ItemsSource="{Binding Editor.AvailableColors}"
                     SelectedItem="{Binding Editor.Color}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="profiles:ProfileColor">
                  <Ellipse Width="26" Height="26"
                           Fill="{Binding Converter={x:Static views:ProfileColorToBrushConverter.Instance}}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
            <Button Classes="ghost" Content="Annuler" IsCancel="True" Command="{Binding CloseEditorCommand}" />
            <Button Classes="accent" IsDefault="True"
                    Content="{Binding Editor.SaveLabel}" Command="{Binding Editor.SaveCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border Classes="scrim" IsVisible="{Binding PendingDeletion, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Classes="dialog">
        <StackPanel Spacing="14">
          <TextBlock Classes="dialogTitle" TextWrapping="Wrap"
                     Text="{Binding PendingDeletion.DisplayName, StringFormat='Supprimer le profil « {0} » ?'}" />
          <TextBlock Classes="body"
                     Text="Sa connexion, ses réglages et ses sessions locales (onglet Code, Cowork) seront effacés de cet ordinateur. Les conversations enregistrées dans le compte Claude restent disponibles sur claude.ai." />
          <TextBlock Classes="body" FontWeight="Medium" Text="Cette action est irréversible." />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Classes="ghost" Content="Annuler" IsCancel="True" Command="{Binding CancelDeletionCommand}" />
            <Button Classes="danger" Content="Supprimer" Command="{Binding ConfirmDeletionCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
